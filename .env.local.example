# ------------------------------------------------------------------
# UNYVON — Supabase configuration (copy to .env.local and fill in)
# ------------------------------------------------------------------
#
# Safely exposable to the browser (public project URL + anon key).
# RLS is the security boundary — the anon key alone grants no data.
#
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only. NEVER expose this to the client, never commit it.
# Used only in server code (auth/organization actions), never imported
# by a "use client" module.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Server-only. Smart Data Import — extraction IA.
# Canonical provider variable: GEMINI_API_KEY (Google AI Studio).
# Optional alternative: OPENAI_API_KEY holding an "sk-..." key (OpenAI-compatible).
# Leave both empty/absent to keep the app in local deterministic fallback mode.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
